# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/servicedesk_pro

# Security & JWT
JWT_SECRET=servicedesk_pro_super_secret_jwt_access_key_2026_x89q
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=servicedesk_pro_super_secret_jwt_refresh_key_2026_m21k
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# AI Configuration (Optional - Smart Fallback included)
AI_PROVIDER=mock
AI_API_KEY=
